# Azure OpenAI
AZURE_ENDPOINT=https://some-endpoint.openai.azure.com/
AZURE_KEY=AZURE_OPENAI_API_KEY
AZURE_VERSION="yyyy-mm-dd-option"

# Ollama
OLLAMA_API_BASE=http://localhost:11434

# OpenAI
OPENAI_API_KEY=OPENAI_API_KEY

# Anthropic
ANTHROPIC_API_KEY=ANTHROPIC_API_KEY

# vLLM OpenAI-compatible endpoint
# Set VLLM_BASE_URL to the server's /v1 endpoint.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# Use local-no-auth if the server does not require authentication.
VLLM_API_KEY=local-no-auth
